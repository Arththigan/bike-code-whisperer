# ─────────────────────────────────────────────────────────────────────────────
# Bike Code Whisperer — Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is git-ignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Config ───────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─────────────────────────────────────────────────────────────────────────────
# Gemini API Keys — Per-Feature Pool
#
# Distribution (8 keys total):
#   Analysis    → KEY_1, KEY_2, KEY_3      (3 keys)
#   Translation → KEY_4, KEY_5             (2 keys)
#   Guide       → KEY_6, KEY_7, KEY_8      (3 keys)
#
# Fallback logic (automatic):
#   - If feature-specific keys are set → use those keys only
#   - If NOT set → falls back to GEMINI_API_KEY (shared)
#
# Start with just GEMINI_API_KEY if you have 1 key.
# Add feature-specific keys when you have more.
#
# Get free keys: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────

# Shared fallback key (used when feature-specific keys are not set)
GEMINI_API_KEY=your_shared_gemini_key
# Server-side alias (same key, both names work)
VITE_GEMINI_API_KEY=your_shared_gemini_key

# ── Analysis Keys (Code search fallback — DB miss aana matrum call aaum) ─────
# Quota used: ~1 call per unique code (cached permanently after first call)
GEMINI_ANALYSIS_KEY_1=your_analysis_key_1
GEMINI_ANALYSIS_KEY_2=your_analysis_key_2
GEMINI_ANALYSIS_KEY_3=your_analysis_key_3

# ── Translation Keys (EN → Tanglish/Tamil toggle) ────────────────────────────
# Quota used: ~1 call per code+language (cached permanently after first call)
GEMINI_TRANSLATE_KEY_1=your_translate_key_1
GEMINI_TRANSLATE_KEY_2=your_translate_key_2

# ── Guide Keys (Analyze Details button — heaviest feature) ───────────────────
# Quota used: ~1 call per code+brand (cached permanently after first call)
GEMINI_GUIDE_KEY_1=your_guide_key_1
GEMINI_GUIDE_KEY_2=your_guide_key_2
GEMINI_GUIDE_KEY_3=your_guide_key_3
